{
  "backend": "tiny",
  "configuration": {
    "seed": 42,
    "model": {
      "backend": "tiny",
      "pretrained": false,
      "feature_dim": 256,
      "hidden_dim": 64,
      "num_experts": 4,
      "expert_top_k": 2,
      "max_agents": 3,
      "device": "cpu",
      "dtype": "float32"
    },
    "routing": {
      "k": 2
    },
    "inference": {
      "instrument_experts": true,
      "sample": false,
      "feature_cache_size": 0
    },
    "training": {
      "stage": "dpo",
      "data": "data/dev/preferences.jsonl",
      "checkpoint": "outputs/checkpoints/tiny-sft",
      "output": "outputs/checkpoints/tiny-preference",
      "epochs": 25,
      "batch_size": 32,
      "learning_rate": 0.0005,
      "weight_decay": 0.01,
      "validation_fraction": 0.2,
      "max_grad_norm": 1.0,
      "beta": 0.1
    }
  },
  "stage": "preference",
  "pretrained": false,
  "action_catalog_size": 485,
  "token_accounting": "whole-state lexical token proxy; no language-model tokenization"
}
